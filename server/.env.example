# Copia este archivo como ".env" y rellena el token.
# Token: ejecuta  node server.js --gen-token  y pega aquí el resultado.
JARVIS_TOKEN=

# Puerto del servidor
PORT=3000

# 127.0.0.1 = solo este PC (recomendado, con "tailscale serve" para el móvil)
# 0.0.0.0   = accesible desde tu red (solo si sabes lo que haces)
HOST=127.0.0.1

# Cerebro por defecto: Ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# Si ya tienes tu propio Jarvis con una URL, ponla aquí y se usará en lugar de Ollama.
# Recibirá POST {"text": "..."} y debe responder {"reply": "..."}
# JARVIS_CHAT_URL=http://127.0.0.1:5000/chat
# JARVIS_CHAT_TOKEN=
# Con tu Jarvis conectado, TODO lo que digas desde el móvil (salvo apagar/reiniciar/suspender,
# que siempre piden confirmación) se le envía a él. Pon 1 para usar también las escenas y apps de actions.json.
# LOCAL_INTENTS=0

# Terminal del móvil (ejecuta comandos reales en el PC). 0 = desactivada, 1 = activada.
ALLOW_EXEC=0

# Si la app del móvil está alojada fuera de este PC (p. ej. en Vercel), pon aquí su dirección
# exacta, sin barra final. Si la sirves desde este mismo servidor, déjalo vacío.
# ALLOWED_ORIGIN=https://tu-jarvis.vercel.app

# --- v2 (opcional) ---
# Prueba sin tocar el PC: registra lo que haría (abrir webs, volumen…) y no ejecuta nada.
# JARVIS_DRY_RUN=1
# Dónde se guardan tus escenas, sitios y ajustes (por defecto: server/data/)
# JARVIS_DATA_DIR=
