# Copia este archivo como pc/.env (pc/.env NUNCA se sube a git).
# Supabase > Project Settings > API
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# La clave «service_role» (Legacy API keys) o una «secret» (sb_secret_...). Se salta RLS: solo en este PC.
SUPABASE_SERVICE_ROLE_KEY=
# Tu id de usuario de Supabase (Authentication > Users). Las órdenes de cualquier otro usuario se ignoran.
ALLOWED_USER_ID=
# Dónde escucha Jarvis en este PC (no hace falta cambiarlo)
JARVIS_URL=http://127.0.0.1:8765/api/movil
